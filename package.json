{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:search": "tsx scripts/seed-search.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "test:db": "node scripts/test-db.mjs",
    "e2e:catalog": "node scripts/test-db.mjs -- npx tsx scripts/e2e-catalog.ts",
    "e2e:recommendations": "node scripts/test-db.mjs -- npx tsx scripts/e2e-recommendations.ts",
    "e2e:cart": "node scripts/test-db.mjs -- sh -c 'npm run db:seed && npx tsx scripts/e2e-cart.ts'",
    "e2e:checkout": "node scripts/test-db.mjs -- sh -c 'npm run db:seed && npx tsx scripts/e2e-checkout.ts'",
    "recommendations:compute": "tsx scripts/recommendations-compute.mjs",
    "cart:maintenance": "tsx scripts/cart-maintenance.mjs",
    "checkout:maintenance": "tsx scripts/checkout-maintenance.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:parity": "node scripts/verify-schema-parity.mjs",
    "db:verify-migrations": "node scripts/verify-migrate-journal.mjs",
    "search:index": "tsx scripts/search-index.mjs",
    "search:status": "tsx scripts/search-index.mjs --status",
    "search:reindex:derived": "tsx scripts/search-index.mjs --derived",
    "search:queue": "tsx scripts/search-index.mjs --queue",
    "search:loadtest": "tsx scripts/search-loadtest.mjs",
    "native:build": "make -C native/cpp-search all && make -C native/c-importer all",
    "native:test": "make -C native/cpp-search test && make -C native/c-importer test",
    "service:test": "cd services/catalog-service && .venv/bin/python -m pytest -q tests"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.4.4",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.48.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "embedded-postgres": "18.4.0-beta.17"
  }
}
