# ─────────────────────────────────────────────────────────────
# Inkline — environment configuration
# Copy to `.env` and fill in values per environment.
# NEVER commit a real `.env`. Never expose secret values to the
# browser — only NEXT_PUBLIC_* variables are client-visible.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Authentication (Auth.js / next-auth v5) ──────────────────
# REQUIRED in every environment. Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Trust the host header (needed on Vercel / reverse proxies)
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments — Razorpay (primary, India) ─────────────────────
# key_id is safe for the browser; key_secret is server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# ── Payments — Stripe (future, international) ────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── POD supplier (Printrove / Printful / QikInk …) ───────────
POD_PROVIDER=
POD_API_BASE_URL=
POD_API_KEY=
POD_API_SECRET=
POD_WEBHOOK_SECRET=
# Set true only when the supplier integration is production-live.
FEATURE_POD_LIVE=false

# ── Object storage (S3-compatible: Cloudflare R2 / AWS S3) ───
# Design artwork, print files and customer uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_CDN_URL=

# ── Transactional email ──────────────────────────────────────
EMAIL_FROM="Inkline <hello@inkline.in>"
RESEND_API_KEY=
# …or SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Analytics & monitoring ───────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
SENTRY_DSN=

# ── Cart lifecycle (Part 14) ─────────────────────────────────
# Guest cart cookie/session lifetime and account-cart inactivity retention.
CART_GUEST_TTL_DAYS=30
CART_USER_TTL_DAYS=180
# Inactivity threshold used by `npm run cart:maintenance` (no marketing is sent).
CART_ABANDONMENT_MINUTES=60

# Part 15 checkout-preparation session lifetime; checkout never reserves stock.
CHECKOUT_SESSION_TTL_MINUTES=45
# PII-bearing checkout snapshots are cleared after expiry/cancellation plus this retention period.
CHECKOUT_PII_RETENTION_DAYS=30

# ── Platform ops ─────────────────────────────────────────────
# Protects future cron/maintenance routes: openssl rand -base64 32
CRON_SECRET=
# Salt for hashing IP addresses stored at rest (privacy).
IP_HASH_SALT=

# ── Search & discovery (Part 12) ─────────────────────────────
# Salt for the search session hash. Search analytics store an HMAC of the user id
# or IP, never the raw value, so logs cannot be reversed into identities.
# REQUIRED in production:  openssl rand -hex 32
# A fallback is used when unset, which is fine locally and unacceptable in prod.
SEARCH_SESSION_SALT=

# Path to the native ranking library. Leave empty to search the usual places
# (native/cpp-search/build/, then the loader path).
# Build it with: npm run native:build
CPPSEARCH_LIBRARY=

# Set ONLY while running `npm run search:loadtest`. The value is the multiplier
# applied to every catalog API rate limit (e.g. 200 = 200×), so the load test
# measures the search engine instead of the limiter.
# Never set this in a deployed environment.
SEARCH_LOADTEST=

# ── Catalog-intelligence service (services/catalog-service) ──
# See services/catalog-service/.env.example for the full list. The service uses
# the same PostgreSQL instance as this app.
CATALOG_SERVICE_DATABASE_URL=
